# Variáveis de ambiente do site Studio MOVA (EasyPanel).
# Copie para .env.local no desenvolvimento e configure no painel em produção.
# NÃO commite valores reais — este arquivo é só o MODELO.

# Supabase (projeto compartilhado — site + GABI). As NEXT_PUBLIC vão pro cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (captcha das telas públicas e do login do admin).
# Se a SITE existir e a SECRET faltar, o envio é RECUSADO (fail-closed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Webhook n8n para AVISAR de um novo lead na hora (WhatsApp da recepção).
# Vazio = lead é gravado normalmente, só não dispara aviso imediato.
N8N_LEAD_WEBHOOK_URL=

# Webhook n8n para reportar ERROS de servidor (instrumentation.ts). Opcional.
N8N_ERROR_WEBHOOK_URL=
